<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.closecode">

    <!-- Everything that opens a socket: the GitHub device flow and REST calls, JGit push/pull,
         and the local preview server (a ServerSocket needs it too). Without this the web
         preview and GitHub are dead on arrival. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The toolchain download checks for Wi-Fi before it starts. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Installing apps the phone itself built: the system still shows its own consent
         screen every time, and Android 12+ needs a one-time allow-this-source toggle
         the app opens settings for but can never flip itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The one-time build-tools download runs as a foreground service so it survives
         leaving the screen; its notification shows the percent and carries Cancel. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only for the Back to editor pill over a built app. Android asks once, in the
         system settings screen; the panel explains why before sending the user there,
         and a notification with the same action is the fallback when it is refused. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ only reports apps this app can see. The built app is launched with
         the package manager's launch intent, so the launcher query is required. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- The GitHub token is kept in this app's private preferences. Disabling backup stops it
         leaving the device through adb backup or cloud restore. -->
    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme"
        android:extractNativeLibs="true">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real @Preview rendering runs in its own process so a bad preview cannot take the
             editor down. Transparent and untouchable: it composes off screen and draws each
             harness into a bitmap. -->
        <activity
            android:name=".preview.PreviewRenderActivity"
            android:process=":preview"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Projects live in the app's private storage, which no other app can open. The
             "Reveal in file manager" action hands out a content:// URI through this provider
             instead of a file:// path, which has been refused since API 24 — and grants only
             the URI, never the directory around it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The build-tools download: continues when the user leaves the setup screen. -->
        <service
            android:name=".build.ToolchainDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- A build keeps its process and its notification while the user is away. -->
        <service
            android:name=".build.BuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compiling and signing an app on the phone" />
        </service>
        <receiver
            android:name=".build.BuildCancelReceiver"
            android:exported="false" />

        <!-- The floating Back to editor pill over the user's built app. -->
        <service
            android:name=".overlay.BackToEditorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Back to editor button over a launched app" />
        </service>
    </application>

</manifest>
