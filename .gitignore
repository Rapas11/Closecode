*.iml
.gradle
/local.properties
/.idea/caches/build_file_checksums.ser
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
.DS_Store
/build
/captures
.externalNativeBuild
.kotlin/

# The pack script's work: downloads, dexed files, unpacked aapt2. Every file it produces
# is rebuilt by scripts/prepare-toolchain.ps1; nothing here belongs in the repository.
/build-toolchain/
*.log

# Placed by the pack script, ~4.5 MB of arm64 aapt2. Rebuilt, never committed. The PTY
# bridge is the exception: it is 10 KB, built by scripts/build-pty.ps1, and the APK needs it.
/app/src/main/jniLibs/**
!/app/src/main/jniLibs/arm64-v8a/
!/app/src/main/jniLibs/arm64-v8a/libclosepty.so

